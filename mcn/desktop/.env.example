# MCN Desktop Environment Variables

# Server port (default: 7842, will auto-find a free port if taken)
MCN_SERVER_PORT=7842

# Set to 1 to enable verbose Python server logging
MCN_DEBUG=0

# Auto-updater feed URL (for electron-updater)
# Example: https://your-release-server.com/updates/
VITE_UPDATE_FEED_URL=

# GitHub release owner/repo for auto-updater (if using github provider)
# VITE_GH_TOKEN=  # only needed for private repos
