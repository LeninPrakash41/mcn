// Smart Home — user interface (web and mobile)

component Home
    state home = {temperature: 0, humidity: 0, motion: 0, door: "Closed", light_text: "", fan_text: "", blinds_text: ""}
    state events = []

    on load
        home = home_state().data
        events = recent_events(6).data

    on light
        toggle("living_light")
        home = home_state().data
        events = recent_events(6).data

    on fan
        toggle("fan")
        home = home_state().data
        events = recent_events(6).data

    on open_blinds
        set_blinds(180)
        home = home_state().data
        events = recent_events(6).data

    on close_blinds
        set_blinds(0)
        home = home_state().data
        events = recent_events(6).data

    on refresh
        home = home_state().data
        events = recent_events(6).data

    render
        div grid_cols=4
            stat_card label="Temperature" value=home.temperature icon="Thermometer" color="orange"
            stat_card label="Humidity" value=home.humidity icon="Droplets" color="blue"
            stat_card label="Front door" value=home.door icon="DoorOpen" color="purple"
            stat_card label="Motion" value=home.motion icon="Activity" color="green"
        div grid_cols=2
            card
                card_header "Living room"
                card_content
                    div
                        p {home.light_text}
                        button "Toggle light" on_click=light
                    separator
                    div
                        p {home.fan_text}
                        button "Toggle fan" on_click=fan variant="outline"
                    separator
                    div
                        p {home.blinds_text}
                        button "Open blinds" on_click=open_blinds variant="outline"
                        button "Close blinds" on_click=close_blinds variant="outline"
            card
                card_header "Recent activity"
                card_content
                    button "Refresh" on_click=refresh variant="ghost"
                    for e in events
                        p {e.line}

component Devices
    state items = []

    on load
        items = list_devices().data

    render
        data_table title="Devices" description="Every sensor and output, with the Raspberry Pi pin it's wired to" columns=["id", "location", "type", "status", "pin"] filters=["location", "type"]

app SmartHome
    title "Smart Home"
    logo "House"
    layout
        sidebar
            nav "Home" Home icon="House"
            nav "Devices" Devices icon="Cpu"
