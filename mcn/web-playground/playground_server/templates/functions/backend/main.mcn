// REPL Quick Script: Functions, Recursion & Logic
function greet(name, prefix = "Welcome")
    return prefix + ", " + name + "!"

function factorial(n)
    if n <= 1
        return 1
    return n * factorial(n - 1)

function clamp(val, min_val, max_val)
    if val < min_val
        return min_val
    if val > max_val
        return max_val
    return val

log(greet("Engineer"))
log("5! = " + str(factorial(5)))
log("7! = " + str(factorial(7)))
log("clamp(150, 0, 100) = " + str(clamp(150, 0, 100)))
