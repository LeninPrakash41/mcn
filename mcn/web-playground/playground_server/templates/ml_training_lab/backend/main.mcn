// ML Training Lab — backend
//
// Predict which customers will cancel (churn) from three features. Everything a
// training run does is written out in MCN so you can read and change it:
// generate data, split it into train and test sets, scale features, train
// logistic regression or k-nearest neighbours, and measure the result.

query("CREATE TABLE IF NOT EXISTS ml_rows (id INTEGER PRIMARY KEY AUTOINCREMENT, tenure_months REAL, monthly_spend REAL, support_calls REAL, churned INTEGER, split TEXT)")
query("CREATE TABLE IF NOT EXISTS ml_experiments (id INTEGER PRIMARY KEY AUTOINCREMENT, model TEXT, params TEXT, accuracy REAL, precision_score REAL, recall REAL, train_rows INTEGER, test_rows INTEGER, ms INTEGER, weights TEXT, created_at TEXT)")

var FEATURES = ["tenure_months", "monthly_spend", "support_calls"]
var E = 2.718281828459045

// ── Data ────────────────────────────────────────────────────────────────────

var rng = [7]
function rand()
    // A small seeded random generator, so every run of the template gets the same data
    rng[0] = (rng[0] * 1103515245 + 12345) % 2147483648
    return rng[0] / 2147483648

function sigmoid(z)
    return 1 / (1 + pow(E, -z))

function generate(n, seed = 7)
    rng[0] = seed
    query("DELETE FROM ml_rows")
    for i in range(n)
        var tenure = round(1 + rand() * 59, 0)
        var spend = round(20 + rand() * 100, 2)
        var calls = round(rand() * 8, 0)
        var risk = sigmoid(-0.15 * tenure + 0.05 * spend + 1.1 * calls - 3.0)
        var churned = 1 if rand() < risk else 0
        var split = "test" if rand() < 0.25 else "train"
        query("INSERT INTO ml_rows (tenure_months, monthly_spend, support_calls, churned, split) VALUES (?, ?, ?, ?, ?)", (tenure, spend, calls, churned, split))
    return n

if query("SELECT COUNT(*) AS n FROM ml_rows")[0].n == 0
    generate(160)

function rows(split)
    return query("SELECT tenure_months, monthly_spend, support_calls, churned FROM ml_rows WHERE split = ?", (split,))

// ── Feature scaling: each feature becomes (value - mean) / std ─────────────

function fit_scaler(data)
    var scaler = {}
    for f in FEATURES
        var total = 0
        for r in data
            total = total + r[f]
        var mean = total / len(data)
        var spread = 0
        for r in data
            spread = spread + pow(r[f] - mean, 2)
        var std = sqrt(spread / len(data))
        scaler[f] = {mean: mean, std: std if std > 0 else 1}
    return scaler

function scale(r, scaler)
    var x = []
    for f in FEATURES
        x.push((r[f] - scaler[f].mean) / scaler[f].std)
    return x

// ── Models ──────────────────────────────────────────────────────────────────

function train_logistic(data, scaler, epochs, learning_rate)
    var w = [0, 0, 0]
    var b = 0
    var xs = []
    for r in data
        xs.push(scale(r, scaler))
    for epoch in range(epochs)
        var gw = [0, 0, 0]
        var gb = 0
        for i in range(len(data))
            var x = xs[i]
            var error = sigmoid(w[0] * x[0] + w[1] * x[1] + w[2] * x[2] + b) - data[i].churned
            gw[0] = gw[0] + error * x[0]
            gw[1] = gw[1] + error * x[1]
            gw[2] = gw[2] + error * x[2]
            gb = gb + error
        for j in range(3)
            w[j] = w[j] - learning_rate * gw[j] / len(data)
        b = b - learning_rate * gb / len(data)
    return {w: w, b: b}

function logistic_probability(model, x)
    return sigmoid(model.w[0] * x[0] + model.w[1] * x[1] + model.w[2] * x[2] + model.b)

function knn_probability(train, train_x, x, k)
    // The share of churners among the k nearest training rows
    var distances = []
    for i in range(len(train))
        var t = train_x[i]
        var d = pow(t[0] - x[0], 2) + pow(t[1] - x[1], 2) + pow(t[2] - x[2], 2)
        distances.push({d: d, churned: train[i].churned})
    var nearest = slice(sort(distances, "d"), 0, k)
    var votes = 0
    for n in nearest
        votes = votes + n.churned
    return votes / len(nearest)

// ── Metrics ─────────────────────────────────────────────────────────────────

function score(predictions, actual)
    var tp = 0
    var fp = 0
    var fn = 0
    var correct = 0
    for i in range(len(actual))
        var p = predictions[i]
        var a = actual[i]
        if p == a
            correct = correct + 1
        if p == 1 and a == 1
            tp = tp + 1
        if p == 1 and a == 0
            fp = fp + 1
        if p == 0 and a == 1
            fn = fn + 1
    return {
        accuracy: round(correct / len(actual), 3) if len(actual) > 0 else 0,
        precision: round(tp / (tp + fp), 3) if tp + fp > 0 else 0,
        recall: round(tp / (tp + fn), 3) if tp + fn > 0 else 0
    }

// ── Training runs ───────────────────────────────────────────────────────────

function run_training(model, epochs = 200, learning_rate = 0.5, k = 7)
    var start = now_ms()
    var train = rows("train")
    var test = rows("test")
    require(len(train) > 0 and len(test) > 0, "Generate or import data first")
    var scaler = fit_scaler(train)
    var predictions = []
    var actual = []
    var saved = {model: model, scaler: scaler}
    var params = ""
    if model == "logistic_regression"
        var fitted = train_logistic(train, scaler, int(epochs), float(learning_rate))
        saved.w = fitted.w
        saved.b = fitted.b
        params = "epochs=" + str(epochs) + ", learning_rate=" + str(learning_rate)
        for r in test
            predictions.push(1 if logistic_probability(fitted, scale(r, scaler)) >= 0.5 else 0)
            actual.push(r.churned)
    else
        require(model == "knn", "Model must be logistic_regression or knn")
        var train_x = []
        for r in train
            train_x.push(scale(r, scaler))
        saved.k = int(k)
        params = "k=" + str(k)
        for r in test
            predictions.push(1 if knn_probability(train, train_x, scale(r, scaler), int(k)) >= 0.5 else 0)
            actual.push(r.churned)
    var m = score(predictions, actual)
    var ms = now_ms() - start
    query("INSERT INTO ml_experiments (model, params, accuracy, precision_score, recall, train_rows, test_rows, ms, weights, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
          (model, params, m.accuracy, m.precision, m.recall, len(train), len(test), ms, to_json(saved), now()))
    return {model: model, params: params, accuracy: m.accuracy, precision: m.precision, recall: m.recall, ms: ms}

function predict_one(experiment, tenure, spend, calls)
    var saved = json_parse(experiment.weights)
    var x = scale({tenure_months: float(tenure), monthly_spend: float(spend), support_calls: float(calls)}, saved.scaler)
    if saved.model == "logistic_regression"
        return logistic_probability(saved, x)
    var train = rows("train")
    var train_x = []
    for r in train
        train_x.push(scale(r, saved.scaler))
    return knn_probability(train, train_x, x, saved.k)

service ml_api
    port 8080

    endpoint dataset_summary()
        var all = query("SELECT split, COUNT(*) AS n, SUM(churned) AS churned FROM ml_rows GROUP BY split")
        var best = query("SELECT accuracy FROM ml_experiments ORDER BY accuracy DESC LIMIT 1")
        var summary = {rows: 0, train: 0, test: 0, churn_rate: 0, best_accuracy: 0, experiments: query("SELECT COUNT(*) AS n FROM ml_experiments")[0].n}
        var churned = 0
        for g in all
            summary[g.split] = g.n
            summary.rows = summary.rows + g.n
            churned = churned + g.churned
        if summary.rows > 0
            summary.churn_rate = round(churned / summary.rows * 100, 1)
        if len(best) > 0
            summary.best_accuracy = round(best[0].accuracy * 100, 1)
        return {success: true, data: summary}

    endpoint list_rows(limit = 200)
        return {success: true, data: query("SELECT id, tenure_months, monthly_spend, support_calls, churned, split FROM ml_rows ORDER BY id LIMIT ?", (limit,))}

    endpoint regenerate(n = 160, seed = 7)
        generate(int(n), int(seed))
        return {success: true, data: {rows: n}}

    endpoint import_rows(csv_text)
        // CSV with columns tenure_months, monthly_spend, support_calls, churned
        var added = 0
        for r in parse_csv(csv_text)
            var split = "test" if rand() < 0.25 else "train"
            query("INSERT INTO ml_rows (tenure_months, monthly_spend, support_calls, churned, split) VALUES (?, ?, ?, ?, ?)",
                  (float(r.tenure_months), float(r.monthly_spend), float(r.support_calls), int(r.churned), split))
            added = added + 1
        return {success: true, data: {added: added}}

    endpoint train_model(model, epochs = 200, learning_rate = 0.5, k = 7)
        return {success: true, data: run_training(model, epochs, learning_rate, k)}

    endpoint list_experiments()
        var runs = query("SELECT id, model, params, accuracy, precision_score AS precision, recall, ms, created_at FROM ml_experiments ORDER BY id DESC")
        for r in runs
            r.name = "#" + str(r.id) + " " + r.model
        return {success: true, data: runs}

    endpoint predict(tenure_months, monthly_spend, support_calls)
        var best = query("SELECT * FROM ml_experiments ORDER BY accuracy DESC, id DESC LIMIT 1")
        if len(best) == 0
            return {success: false, error: "Train a model first"}
        var p = predict_one(best[0], tenure_months, monthly_spend, support_calls)
        var verdict = "Likely to churn" if p >= 0.5 else "Likely to stay"
        return {success: true, data: {probability: round(p * 100, 1), verdict: verdict, model: "#" + str(best[0].id) + " " + best[0].model,
                                      text: verdict + " (" + str(round(p * 100, 1)) + "% churn risk, model #" + str(best[0].id) + ")"}}

test "scaling centres each feature"
    var s = fit_scaler([{tenure_months: 1, monthly_spend: 10, support_calls: 0}, {tenure_months: 3, monthly_spend: 30, support_calls: 2}])
    assert s.tenure_months.mean == 2
    assert scale({tenure_months: 3, monthly_spend: 30, support_calls: 2}, s)[0] == 1

test "both models learn better than guessing"
    generate(160)
    var lr = run_training("logistic_regression", 150, 0.5)
    var knn = run_training("knn", 0, 0, 7)
    assert lr.accuracy > 0.75
    assert knn.accuracy > 0.7

test "predictions are probabilities"
    run_training("logistic_regression", 100, 0.5)
    var p = predict(2, 110, 7).data
    assert p.probability >= 0 and p.probability <= 100
