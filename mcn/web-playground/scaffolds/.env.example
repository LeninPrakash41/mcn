# MCN application settings — copy to .env and fill in

PORT=8080

# Signs login tokens (auth_create_token, auth "jwt"). Use a long random string:
#   openssl rand -hex 32
MCN_AUTH_SECRET=

# Bearer token clients must send when the service declares: auth "token"
MCN_API_TOKEN=

# Origins allowed to call the API from a browser (comma-separated; * for any)
MCN_CORS_ORIGINS=http://localhost:3000

# Optional
ANTHROPIC_API_KEY=
