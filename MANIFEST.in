include README.md
include LICENSE
include CONTRIBUTING.md
include requirements.txt
include mcn/version.py
recursive-include examples *.mcn *.csv
recursive-include use-cases *.mcn
recursive-include docs *.md *.mcn
include mcn/studio/vscode-mcn/package.json
include mcn/studio/vscode-mcn/*.vsix
recursive-include mcn/studio/vscode-mcn/syntaxes *.json
include mcn/web-playground/index.html
recursive-include mcn/web-playground/static *.css *.js
recursive-include mcn/ui-kit/react/src *.ts *.tsx
prune mcn/ui-kit/react/node_modules
recursive-include mcn/web-playground/playground_server *.py *.html *.json *.mcn
recursive-include mcn/web-playground/scaffolds *
include mcn/core_engine/.mcn_official
prune mcn/web-playground/workspace
prune mcn/web-playground/node_modules
prune mcn/desktop/node_modules
prune mcn/studio/vscode-mcn/node_modules
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
global-exclude *.log
global-exclude *.db
include mcn/fullstack/*.dart
recursive-include mcn/iot_firmware *.ino
