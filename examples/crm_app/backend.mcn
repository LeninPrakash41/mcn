// Sales CRM — backend.   Run:  mcn serve --file backend.mcn --port 8080

include "models.mcn"

service crm
    port 8080

    // Everyone can read; sales and admins can edit; only admins delete leads
    // and companies. Every change is recorded in the activity log.
    crud Lead
        search       name, email
        sort         created_at desc
        page_size    10
        allow read:   admin, sales, viewer
        allow write:  admin, sales
        allow delete: admin
        audit
        import
        export

    crud Company
        search       name, city
        sort         name
        allow read:   admin, sales, viewer
        allow write:  admin, sales
        allow delete: admin
        audit
        import
        export

    // Quotes with more than 10% discount wait for an admin's approval
    crud Quote
        search       title
        allow read:   admin, sales, viewer
        allow write:  admin, sales
        allow delete: admin
        audit
        approval
            approvers admin
            when      record.discount > 10

    crud FollowUp
        search       title
        sort         due
        allow read:   admin, sales, viewer
        allow write:  admin, sales
        allow delete: admin, sales
        audit

    // Any signed-in user. (Use `allow admin, sales` to limit, or `public`.)
    endpoint get_dashboard()
        var open = query("SELECT COUNT(*) AS n, COALESCE(SUM(value), 0) AS total FROM leads WHERE stage NOT IN ('won', 'lost')")[0]
        var won  = query("SELECT COUNT(*) AS n, COALESCE(SUM(value), 0) AS total FROM leads WHERE stage = 'won'")[0]
        var todo = query("SELECT COUNT(*) AS n FROM follow_ups WHERE done = 0")[0]

        var stages = []
        for row in query("SELECT stage, COUNT(*) AS count, SUM(value) AS total FROM leads GROUP BY stage ORDER BY total DESC")
            stages = stages + [{stage: row.stage, count: row.count, total: format_currency(row.total)}]

        return {
            open_leads:      open.n,
            pipeline:        format_currency(open.total),
            won_deals:       won.n,
            won_value:       format_currency(won.total),
            open_follow_ups: todo.n,
            stages:          stages,
            upcoming:        query("SELECT f.title, l.name AS lead, f.due, f.priority FROM follow_ups f JOIN leads l ON l.id = f.lead WHERE f.done = 0 ORDER BY f.due LIMIT 5")
        }

    // ── Workflows ────────────────────────────────────────────────────────────

    // When a lead is won: tell the manager and book the kick-off
    on update Lead
        if changed("stage") and record.stage == "won"
            send_email("manager@crm.local", "Won: {record.name} ({format_currency(record.value)})",
                       "{record.name} from {record.company_label} is now a customer.")
            create_follow_up({title: "Kick-off meeting", lead: record.id, due: add_days(today(), 2), priority: "high"})

    // Approved quote → PDF emailed to the sales team
    on approve Quote
        var net = record.amount * (100 - record.discount) / 100
        var pdf = make_pdf("Quote: {record.title}", [
            "For {record.lead_label}. Approved by {record.approval_by}.",
            [["Item", "Amount"],
             ["List price", format_currency(record.amount)],
             ["Discount", "{record.discount}%"],
             ["Total", format_currency(net)]]
        ])
        send_email("sales@crm.local", "Quote approved: {record.title}", "The approved quote is attached.", [pdf])

    on reject Quote
        send_email("sales@crm.local", "Quote rejected: {record.title}", "Reason: {record.approval_note}")

    // Every morning: overdue follow-ups, as a PDF
    job overdue_digest every day at "09:00"
        var overdue = query("SELECT f.title, l.name AS lead, f.due FROM follow_ups f JOIN leads l ON l.id = f.lead WHERE f.done = 0 AND f.due < date('now') ORDER BY f.due")
        if overdue
            var pdf = make_pdf("Overdue follow-ups", [overdue])
            send_email("manager@crm.local", "{overdue.length} overdue follow-ups", "See attached.", [pdf])

// Sample data on first run, so there's something to see
include "seed.mcn"

test "dashboard adds up open pipeline"
    var d = get_dashboard()
    assert d.open_leads >= 0
    assert d.pipeline != ""
