// Sales CRM — data model, shared by the backend and the UI.
// Every contract becomes a database table, five API endpoints and a screen.
// `ref` links records: a lead belongs to a company, a follow-up to a lead.

// Sign-in with three roles. The first role is the administrator: it manages
// users and sees the activity log.
auth
    roles         admin, sales, viewer
    session_hours 12
    // Single sign-on: uncomment and set the environment variables
    // (register <backend>/sso_callback as the redirect URL at your provider)
    // sso
    //     issuer        "https://accounts.google.com"
    //     client_id     env("SSO_CLIENT_ID")
    //     client_secret env("SSO_CLIENT_SECRET")
    //     allow_domains "yourcompany.com"
    //     default_role  viewer

contract Lead
    name:      str
    email:     str unique
    phone:     str?
    company:   ref Company?
    stage:     choice("new", "contacted", "qualified", "won", "lost") = "new"
    value:     float = 0
    source:    choice("website", "referral", "event", "cold_call", "partner") = "website"
    follow_up:  date?
    proposal:   file?                                   // upload a PDF / doc
    commission: float?  read admin  write admin         // only admins see this
    notes:      text?

contract Company
    name:     str unique
    industry: choice("software", "manufacturing", "healthcare", "retail", "finance", "other") = "software"
    city:     str?
    website:  str?
    size:     int?

contract FollowUp
    title:    str
    lead:     ref Lead
    due:      date
    priority: choice("low", "medium", "high") = "medium"
    done:     bool = false

contract Quote
    title:    str
    lead:     ref Lead
    amount:   float
    discount: float = 0                                 // percent
    valid_until: date?
